+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+env:
+  CARGO_TERM_COLOR: always
+
+jobs:
+  rust:
+    name: Rust (${{ matrix.os }})
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false   # a Windows failure must not hide what macOS says
+      matrix:
+        os: [ubuntu-latest, windows-latest, macos-latest]
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: dtolnay/rust-toolchain@stable
+
+      - uses: Swatinem/rust-cache@v2
+
+      - name: Linux system libraries (Tauri, FUSE, keyring)
+        if: runner.os == 'Linux'
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev \
+            libfuse3-dev libdbus-1-dev libssl-dev pkg-config
+
+      # Engine: unit tests plus the end-to-end test against the in-process fake Google.
+      - name: Test core
+        run: cargo test -p clouddrive-core
+
+      # Loopback media server tests (also compiles the Tauri app).
+      - name: Test GUI crate
+        run: cargo test -p clouddrive-gui
+
+      # The FUSE crate is a stub off Linux; this proves the whole workspace still builds everywhere.
+      - name: Build everything
+        run: cargo build --workspace
+
+  frontend:
+    name: Frontend (jsdom)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Smoke tests
+        working-directory: gui/frontend-tests
+        run: |
+          npm install --no-audit --no-fund
+          npm test
